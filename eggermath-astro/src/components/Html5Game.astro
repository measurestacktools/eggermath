---
/**
 * Reusable HTML5 provider embed. Single iframe implementation for all
 * provider games — pages never write their own iframe markup.
 *
 * Props: game { slug, title, embedUrl, provider }, aspect ("16-9" | "4-3" | "3-4")
 * Most action shooters are landscape 16:9.
 */
const { game, aspect = '16-9' } = Astro.props;

const ratios = { '16-9': '56.25%', '4-3': '75%', '3-4': '133.33%' };
const padTop = ratios[aspect] || ratios['16-9'];

if (!game || !game.embedUrl || !/^https:\/\//.test(game.embedUrl)) {
  throw new Error(`Html5Game: missing or non-https embedUrl for "${game?.slug}" — refusing to render an empty frame.`);
}
---
<div class="html5-wrap" data-html5-slug={game.slug}>
  <div class="html5-loader" aria-hidden="true"><div class="spinner"></div><p>Loading {game.title}...</p></div>
  <div class="html5-ratio" style={`padding-top:${padTop}`}>
    <iframe
      src={game.embedUrl}
      title={`Play ${game.title} online free`}
      width="100%"
      height="100%"
      frameborder="0"
      scrolling="no"
      loading="lazy"
      allow="autoplay; fullscreen"
      allowfullscreen
      referrerpolicy="strict-origin-when-cross-origin"
    ></iframe>
  </div>
  <div class="html5-fallback" hidden>
    <h3>{game.title} could not load</h3>
    <p>The game provider did not respond. Check your connection and try again — or pick another shooter below.</p>
    <button type="button" class="html5-retry">Retry</button>
  </div>
  <div class="html5-bar">
    <button type="button" class="html5-fs" title="Fullscreen">⛶ Fullscreen</button>
  </div>
</div>
<script>
  document.querySelectorAll('.html5-wrap').forEach(function (wrap) {
    var frame = wrap.querySelector('iframe');
    var loader = wrap.querySelector('.html5-loader');
    var fallback = wrap.querySelector('.html5-fallback');
    var hideLoader = function () { if (loader) loader.style.display = 'none'; };
    if (frame) {
      frame.addEventListener('load', function () {
        // A loaded frame may still be an error page; give the game a moment, then clear the loader.
        setTimeout(hideLoader, 2500);
      });
    }
    // If nothing renders within 30s, surface the fallback instead of a dead frame.
    setTimeout(function () {
      if (!frame) return;
      var dead = false;
      try { dead = frame.contentDocument && frame.contentDocument.body && frame.contentDocument.body.textContent.trim().length < 50; }
      catch (e) { dead = false; /* cross-origin: assume alive if load fired */ }
      if (dead) { hideLoader(); if (fallback) fallback.hidden = false; }
      else hideLoader();
    }, 30000);
    var retry = wrap.querySelector('.html5-retry');
    if (retry) retry.addEventListener('click', function () {
      if (fallback) fallback.hidden = true;
      if (loader) loader.style.display = '';
      try { frame.src = frame.src; } catch (e) {}
    });
    var fs = wrap.querySelector('.html5-fs');
    if (fs) fs.addEventListener('click', function () {
      var el = wrap.querySelector('.html5-ratio');
      try {
        if (document.fullscreenElement) document.exitFullscreen();
        else if (el.requestFullscreen) el.requestFullscreen();
        else if (el.webkitRequestFullscreen) el.webkitRequestFullscreen();
      } catch (e) {}
    });
  });
</script>
<style>
  .html5-wrap { max-width: none; margin: 0; }
  .html5-ratio { position: relative; overflow: hidden; height: 0; width: 100%; background: #000; border-radius: 16px; border: 1px solid rgba(255,255,255,0.08); box-shadow: 0 12px 48px rgba(0,0,0,0.55); }
  .html5-ratio iframe { position: absolute; top: 0; left: 0; width: 100%; height: 100%; border: 0; }
  .html5-loader { text-align: center; padding: 32px 0; color: var(--text-muted); }
  .html5-loader .spinner { width: 36px; height: 36px; margin: 0 auto 12px; border: 3px solid rgba(196,163,90,0.25); border-top-color: #c4a35a; border-radius: 50%; animation: html5spin 0.9s linear infinite; }
  @keyframes html5spin { to { transform: rotate(360deg); } }
  .html5-fallback { text-align: center; padding: 32px 16px; background: rgba(231,76,60,0.06); border: 1px solid rgba(231,76,60,0.3); border-radius: 12px; margin-top: 12px; }
  .html5-retry { background: #c4a35a; color: #0d0d0d; border: none; padding: 10px 28px; border-radius: 8px; font-weight: 700; cursor: pointer; margin-top: 8px; }
  .html5-bar { display: flex; justify-content: flex-end; margin-top: 8px; }
  .html5-fs { background: rgba(255,255,255,0.06); color: var(--text); border: 1px solid rgba(255,255,255,0.12); border-radius: 8px; padding: 8px 16px; cursor: pointer; font-size: 0.85rem; }
  .html5-fs:hover { background: rgba(196,163,90,0.15); }
</style>
