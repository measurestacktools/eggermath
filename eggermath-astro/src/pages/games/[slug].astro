---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Html5Game from '../../components/Html5Game.astro';
import RatingWidget from '../../components/RatingWidget.astro';
import { SITE } from '../../data/games.js';
import { html5Games, html5Providers } from '../../data/html5-games.js';

export function getStaticPaths() {
  return html5Games.map(game => ({
    params: { slug: game.slug },
    props: { game },
  }));
}

const { game } = Astro.props;
const provider = html5Providers[game.provider];
const pageTitle = `Play ${game.title} Online Free`;
const pageDesc = game.description;
const canonical = `${SITE.url}/games/${game.slug}`;
const related = html5Games.filter(g => g.slug !== game.slug);

const faqsBySlug = {
  'johnny-trigger': [
    { q: 'How do you play Johnny Trigger?', a: 'Aim with your mouse or finger and release to shoot. Johnny fires while flipping through the air — time shots to hit enemies and avoid civilians. Press R to restart a level.' },
    { q: 'Is Johnny Trigger free?', a: 'Yes. Johnny Trigger is free on EggerMath via an officially embedded HTML5 version. No download, no signup.' },
    { q: 'Can I play Johnny Trigger on mobile?', a: 'Yes. The game supports touch controls and runs in Chrome or Safari on phones and tablets.' },
    { q: 'What do I do if the game does not load?', a: 'Check your connection and tap Retry under the game frame. The game is hosted by Embed.Games — if their server is down, try again in a few minutes or pick another shooter below.' },
  ],
  bowmasters: [
    { q: 'How do you aim in Bowmasters?', a: 'Drag anywhere to draw the bow, watch the trajectory arc, and release to fire. Higher drag means more power. Wind and distance matter in later duels.' },
    { q: 'Is Bowmasters free?', a: 'Yes. Bowmasters is free on EggerMath via an officially embedded HTML5 version. No download, no signup.' },
    { q: 'Can I play Bowmasters on mobile?', a: 'Yes. Touch aiming works in mobile Chrome and Safari — drag and release just like a mouse.' },
    { q: 'How do I unlock characters and weapons?', a: 'Progress in the embedded game unlocks fighters and weapons automatically. Progress is stored by the game provider in your browser.' },
  ],
  'crush-the-castle': [
    { q: 'How do you aim the trebuchet in Crush the Castle?', a: 'Drag the trebuchet arm to set angle and power, then release to launch. Heavy stones break stone, lighter shots arc over walls. Destroy every defender to clear the castle.' },
    { q: 'Is Crush the Castle free?', a: 'Yes. Crush the Castle: Siege Master is free on EggerMath via an officially embedded HTML5 version. No download, no signup.' },
    { q: 'Can I play Crush the Castle on mobile?', a: 'Yes. The trebuchet controls work with touch in mobile Chrome and Safari.' },
    { q: 'What do I do if the game does not load?', a: 'Check your connection and tap Retry under the game frame. The game is hosted by Embed.Games — if their server is down, try again in a few minutes or pick another shooter below.' },
  ],
};

const faqs = faqsBySlug[game.slug] || [
  { q: `How do you play ${game.title}?`, a: game.controls },
  { q: `Is ${game.title} free?`, a: `Yes. ${game.title} is free on EggerMath via an officially embedded HTML5 version. No download, no signup.` },
  { q: `Can I play ${game.title} on mobile?`, a: 'Yes, touch controls work in mobile Chrome and Safari.' },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "VideoGame",
      "name": pageTitle,
      "description": pageDesc,
      "url": canonical + '/',
      "image": game.thumbnail,
      "genre": "Action",
      "applicationCategory": "Game",
      "isAccessibleForFree": true,
      "inLanguage": "en",
      "author": { "@type": "Organization", "name": game.developer || provider.name },
      "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
    },
    {
      "@type": "WebSite",
      "name": "EggerMath",
      "url": SITE.url
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": SITE.url },
        { "@type": "ListItem", "position": 2, "name": "HTML5 Games", "item": `${SITE.url}/games` },
        { "@type": "ListItem", "position": 3, "name": "Action", "item": `${SITE.url}/games/action` },
        { "@type": "ListItem", "position": 4, "name": game.title, "item": canonical + '/' }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": faqs.map(f => ({
        "@type": "Question",
        "name": f.q,
        "acceptedAnswer": { "@type": "Answer", "text": f.a }
      }))
    }
  ]
};
---
<BaseLayout title={`${pageTitle} | EggerMath`} description={pageDesc} canonical={canonical} jsonLd={jsonLd} ogImage={game.thumbnail}>
  <main class="main" style="max-width:1200px;margin:0 auto;padding:16px 24px 24px">
    <nav style="font-size:12px;margin-bottom:10px">
      <a href="/" style="color:#c4a35a;text-decoration:none">Home</a> <span>›</span>
      <a href="/games" style="color:#c4a35a;text-decoration:none">HTML5 Games</a> <span>›</span>
      <a href="/games/action" style="color:#c4a35a;text-decoration:none">Action</a> <span>›</span>
      <span>{game.title}</span>
    </nav>

    <div class="html5-stage">
      <div class="html5-player-col">
        <Html5Game game={game} aspect="16-9" />
        <div class="html5-titlebar">
          <img src={game.thumbnail} alt={game.title} width="56" height="56" loading="lazy" />
          <div class="html5-titlebar-text">
            <h1>{pageTitle}</h1>
            <p class="html5-dev">by {game.developer || provider.name} · Action shooter{game.mobileSupport ? ' · Mobile ready' : ''}</p>
          </div>
          <div class="html5-titlebar-rate">
            <RatingWidget slug={`html5-${game.slug}`} title={game.title} />
          </div>
        </div>
        <div class="html5-chips">
          <a href="/games/action">🎯 Action Shooters</a>
          <a href="/games">🎮 All HTML5 Games</a>
          <a href="/">🕹️ GBA Emulator</a>
        </div>
      </div>
      <aside class="html5-rail" aria-label="More games and ads">
        <div class="side-rail-slot" style="display:flex;justify-content:center;margin-bottom:16px;min-height:0;"></div>
        <h2>More Shooters</h2>
        <div class="html5-rail-tiles">
          {related.map(g => (
            <a href={`/games/${g.slug}/`}>
              <img src={g.thumbnail} alt={`Play ${g.title} online`} loading="lazy" width="300" height="169" />
              <span>{g.title}</span>
            </a>
          ))}
        </div>
      </aside>
    </div>

    <div class="html5-body">
      <section>
        <h2>About {game.title}</h2>
        <p>{pageDesc} {game.title} runs as an officially embedded HTML5 game provided by {provider.name} — it loads instantly in Chrome, Edge, Firefox, and Safari with no download and no signup.</p>
        {game.features && game.features.length > 0 && (
          <ul class="html5-features">
            {game.features.map(f => (<li>{f}</li>))}
          </ul>
        )}
      </section>

      <section>
        <h2>Controls</h2>
        <p>{game.controls}</p>
        <p class="html5-note">Tip: use the Fullscreen button above the game for big-screen play. Keyboard and gamepad support varies by title — mouse/touch works everywhere.</p>
      </section>

      <section>
        <h2>Mobile & Browser Info</h2>
        <p>Plays in any modern mobile or desktop browser. On phones, rotate to landscape for the largest play area. Progress and unlocks are stored by the game provider in your browser — clearing site data may reset them.</p>
      </section>

      <section>
        <h2>FAQ — {game.title}</h2>
        {faqs.map(f => (
          <details><summary>{f.q}</summary><p>{f.a}</p></details>
        ))}
      </section>

      <div class="html5-cta">
        <h2>More Free HTML5 Games</h2>
        <p>Shooters and action games that run instantly in your browser.</p>
        <a href="/games/action">Browse Action Games →</a>
      </div>
    </div>
  </main>
</BaseLayout>

<style>
  .html5-stage { display: grid; grid-template-columns: minmax(0, 1fr) 300px; gap: 20px; align-items: start; }
  .html5-titlebar { display: flex; align-items: center; gap: 12px; background: #111; border: 1px solid #1e1e22; border-radius: 12px; padding: 12px 16px; margin-top: 12px; }
  .html5-titlebar img { width: 56px; height: 56px; border-radius: 10px; object-fit: cover; flex-shrink: 0; }
  .html5-titlebar-text { flex: 1; min-width: 0; }
  .html5-titlebar-text h1 { font-size: 1.25rem; margin: 0 0 2px; }
  .html5-dev { color: #888; font-size: 0.8rem; margin: 0; }
  .html5-chips { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 12px; }
  .html5-chips a { color: #c4a35a; text-decoration: none; font-size: 0.8rem; padding: 6px 12px; border: 1px solid rgba(196,163,90,0.3); border-radius: 999px; }
  .html5-chips a:hover { background: rgba(196,163,90,0.12); }
  .html5-rail h2 { font-size: 1rem; margin: 0 0 10px; color: #f0ebe0; }
  .html5-rail-tiles { display: flex; flex-direction: column; gap: 12px; }
  .html5-rail-tiles a { display: flex; gap: 10px; align-items: center; text-decoration: none; color: #f0ebe0; background: #111; border: 1px solid #1e1e22; border-radius: 10px; overflow: hidden; }
  .html5-rail-tiles img { width: 120px; height: 68px; object-fit: cover; flex-shrink: 0; }
  .html5-rail-tiles span { font-size: 0.85rem; font-weight: 600; padding-right: 8px; }
  .html5-body { max-width: 800px; margin-top: 8px; }
  .html5-body section { margin-top: 24px; }
  .html5-body h2 { font-size: 1.3rem; margin-bottom: 8px; color: #c4a35a; }
  .html5-body p { color: #ccc; line-height: 1.7; }
  .html5-note { color: #888 !important; font-size: 0.85rem !important; margin-top: 8px !important; }
  .html5-features { padding-left: 20px; color: #ccc; margin: 12px 0 0; display: flex; flex-direction: column; gap: 6px; }
  .html5-body details { padding: 8px 0; border-bottom: 1px solid rgba(255,255,255,0.06); }
  .html5-body summary { cursor: pointer; font-weight: 600; color: #f0ebe0; }
  .html5-body details p { color: #aaa; font-size: 14px; margin-top: 6px; }
  .html5-cta { margin-top: 32px; padding: 20px; background: #111; border: 1px solid #1e1e22; border-radius: 12px; }
  .html5-cta h2 { font-size: 1.1rem; margin-bottom: 8px; }
  .html5-cta p { color: #aaa; font-size: 14px; margin-bottom: 12px; }
  .html5-cta a { color: #c4a35a; text-decoration: none; font-weight: 700; }
  @media (max-width: 900px) {
    .html5-stage { grid-template-columns: 1fr; }
    .html5-rail-tiles { flex-direction: row; flex-wrap: wrap; }
    .html5-rail-tiles a { flex: 1 1 200px; }
    .html5-titlebar-text h1 { font-size: 1.05rem; }
  }
</style>
