---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Html5Game from '../../components/Html5Game.astro';
import { SITE } from '../../data/games.js';
import { html5Games, html5Providers } from '../../data/html5-games.js';

export function getStaticPaths() {
  return html5Games.map(game => ({
    params: { slug: game.slug },
    props: { game },
  }));
}

const { game } = Astro.props;
const provider = html5Providers[game.provider];
const pageTitle = `Play ${game.title} Online Free`;
const pageDesc = game.description;
const canonical = `${SITE.url}/games/${game.slug}`;
const related = html5Games.filter(g => g.slug !== game.slug);

const faqsBySlug = {
  'johnny-trigger': [
    { q: 'How do you play Johnny Trigger?', a: 'Aim with your mouse or finger and release to shoot. Johnny fires while flipping through the air — time shots to hit enemies and avoid civilians. Press R to restart a level.' },
    { q: 'Is Johnny Trigger free?', a: 'Yes. Johnny Trigger is free on EggerMath via an officially embedded HTML5 version. No download, no signup.' },
    { q: 'Can I play Johnny Trigger on mobile?', a: 'Yes. The game supports touch controls and runs in Chrome or Safari on phones and tablets.' },
    { q: 'What do I do if the game does not load?', a: 'Check your connection and tap Retry under the game frame. The game is hosted by Embed.Games — if their server is down, try again in a few minutes or pick another shooter below.' },
  ],
  bowmasters: [
    { q: 'How do you aim in Bowmasters?', a: 'Drag anywhere to draw the bow, watch the trajectory arc, and release to fire. Higher drag means more power. Wind and distance matter in later duels.' },
    { q: 'Is Bowmasters free?', a: 'Yes. Bowmasters is free on EggerMath via an officially embedded HTML5 version. No download, no signup.' },
    { q: 'Can I play Bowmasters on mobile?', a: 'Yes. Touch aiming works in mobile Chrome and Safari — drag and release just like a mouse.' },
    { q: 'How do I unlock characters and weapons?', a: 'Progress in the embedded game unlocks fighters and weapons automatically. Progress is stored by the game provider in your browser.' },
  ],
  'crush-the-castle': [
    { q: 'How do you aim the trebuchet in Crush the Castle?', a: 'Drag the trebuchet arm to set angle and power, then release to launch. Heavy stones break stone, lighter shots arc over walls. Destroy every defender to clear the castle.' },
    { q: 'Is Crush the Castle free?', a: 'Yes. Crush the Castle: Siege Master is free on EggerMath via an officially embedded HTML5 version. No download, no signup.' },
    { q: 'Can I play Crush the Castle on mobile?', a: 'Yes. The trebuchet controls work with touch in mobile Chrome and Safari.' },
    { q: 'What do I do if the game does not load?', a: 'Check your connection and tap Retry under the game frame. The game is hosted by Embed.Games — if their server is down, try again in a few minutes or pick another shooter below.' },
  ],
};

const faqs = faqsBySlug[game.slug] || [
  { q: `How do you play ${game.title}?`, a: game.controls },
  { q: `Is ${game.title} free?`, a: `Yes. ${game.title} is free on EggerMath via an officially embedded HTML5 version. No download, no signup.` },
  { q: `Can I play ${game.title} on mobile?`, a: 'Yes, touch controls work in mobile Chrome and Safari.' },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "VideoGame",
      "name": pageTitle,
      "description": pageDesc,
      "url": canonical + '/',
      "image": game.thumbnail,
      "genre": "Action",
      "applicationCategory": "Game",
      "isAccessibleForFree": true,
      "inLanguage": "en",
      "author": { "@type": "Organization", "name": game.developer || provider.name },
      "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
    },
    {
      "@type": "WebSite",
      "name": "EggerMath",
      "url": SITE.url
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": SITE.url },
        { "@type": "ListItem", "position": 2, "name": "HTML5 Games", "item": `${SITE.url}/games` },
        { "@type": "ListItem", "position": 3, "name": "Action", "item": `${SITE.url}/games/action` },
        { "@type": "ListItem", "position": 4, "name": game.title, "item": canonical + '/' }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": faqs.map(f => ({
        "@type": "Question",
        "name": f.q,
        "acceptedAnswer": { "@type": "Answer", "text": f.a }
      }))
    }
  ]
};
---
<BaseLayout title={`${pageTitle} | EggerMath`} description={pageDesc} canonical={canonical} jsonLd={jsonLd} ogImage={game.thumbnail}>
  <main class="main" style="max-width:960px;margin:0 auto;padding:24px">
    <nav class="game-breadcrumb" style="font-size:12px;margin-bottom:12px">
      <a href="/" style="color:#c4a35a;text-decoration:none">Home</a> <span>›</span>
      <a href="/games" style="color:#c4a35a;text-decoration:none">HTML5 Games</a> <span>›</span>
      <a href="/games/action" style="color:#c4a35a;text-decoration:none">Action</a> <span>›</span>
      <span>{game.title}</span>
    </nav>

    <h1 style="font-size:2rem;margin:8px 0 4px">Play {game.title} Online</h1>
    <p style="color:#aaa;margin-bottom:20px">{pageDesc}</p>

    <Html5Game game={game} aspect="16-9" />

    <section style="margin-top:28px">
      <h2 style="font-size:1.3rem;margin-bottom:8px;color:#c4a35a">About {game.title}</h2>
      <p style="color:#ccc;line-height:1.7">{pageDesc} {game.title} runs as an officially embedded HTML5 game provided by {provider.name} — it loads instantly in Chrome, Edge, Firefox, and Safari with no download and no signup.</p>
      <p style="color:#888;font-size:0.85rem;margin-top:8px">Genre: Action shooter{game.year ? ` · ${game.year}` : ''}{game.mobileSupport ? ' · Touch supported on iOS/Android' : ''}</p>
    </section>

    <section style="margin-top:24px">
      <h2 style="font-size:1.3rem;margin-bottom:8px;color:#c4a35a">Controls</h2>
      <p style="color:#ccc;line-height:1.7">{game.controls}</p>
      <p style="color:#888;font-size:0.85rem;margin-top:8px">Tip: use the Fullscreen button above the game for big-screen play. Keyboard and gamepad support varies by title — mouse/touch works everywhere.</p>
    </section>

    <section style="margin-top:24px">
      <h2 style="font-size:1.3rem;margin-bottom:8px;color:#c4a35a">Mobile & Browser Info</h2>
      <p style="color:#ccc;line-height:1.7">Plays in any modern mobile or desktop browser. On phones, rotate to landscape for the largest play area. Progress and unlocks are stored by the game provider in your browser — clearing site data may reset them.</p>
    </section>

    {related.length > 0 && (
      <section style="margin-top:24px">
        <h2 style="font-size:1.3rem;margin-bottom:12px;color:#c4a35a">More Action Shooters</h2>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:16px">
          {related.map(g => (
            <a href={`/games/${g.slug}/`} style="text-decoration:none;color:#f0ebe0;background:#111;border:1px solid #1e1e22;border-radius:12px;overflow:hidden;display:block">
              <img src={g.thumbnail} alt={`Play ${g.title} online`} loading="lazy" width="400" height="225" style="width:100%;aspect-ratio:16/9;object-fit:cover;display:block" />
              <div style="padding:12px;font-weight:700">{g.title}</div>
            </a>
          ))}
        </div>
      </section>
    )}

    <section style="margin-top:24px">
      <h2 style="font-size:1.3rem;margin-bottom:8px;color:#c4a35a">FAQ — {game.title}</h2>
      {faqs.map(f => (
        <details style="padding:8px 0;border-bottom:1px solid rgba(255,255,255,0.06)"><summary style="cursor:pointer;font-weight:600;color:#f0ebe0">{f.q}</summary><p style="color:#aaa;font-size:14px;margin-top:6px">{f.a}</p></details>
      ))}
    </section>

    <div style="margin-top:32px;padding:20px;background:#111;border:1px solid #1e1e22;border-radius:12px">
      <h2 style="font-size:1.1rem;margin-bottom:8px">More Free HTML5 Games</h2>
      <p style="color:#aaa;font-size:14px;margin-bottom:12px">Shooters and action games that run instantly in your browser.</p>
      <a href="/games/action" style="color:#c4a35a;text-decoration:none;font-weight:700">Browse Action Games →</a>
    </div>
  </main>
</BaseLayout>
