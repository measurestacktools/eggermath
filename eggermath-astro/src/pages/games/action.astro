---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../data/games.js';
import { getHtml5ByCategory, html5Categories } from '../../data/html5-games.js';

const category = html5Categories.find(c => c.slug === 'action');
const list = getHtml5ByCategory('action');
const [featured, ...rest] = list;

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ItemList",
      "name": "Best HTML5 Action Shooters to Play Online",
      "description": category.description,
      "itemListElement": list.map((g, i) => ({
        "@type": "ListItem",
        "position": i + 1,
        "item": { "@type": "VideoGame", "name": g.title, "url": `${SITE.url}/games/${g.slug}/`, "genre": "Action", "applicationCategory": "Game" }
      }))
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        { "@type": "Question", "name": "What are the best free HTML5 shooters?", "acceptedAnswer": { "@type": "Answer", "text": "Johnny Trigger for stunt shooting, Bowmasters for archery duels, and Crush the Castle for physics sieges — all free in your browser." } },
        { "@type": "Question", "name": "Do HTML5 shooters work on mobile?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. Every game here supports touch controls in mobile Chrome and Safari. Rotate to landscape for the biggest play area." } },
        { "@type": "Question", "name": "Do I need to download anything?", "acceptedAnswer": { "@type": "Answer", "text": "No. All HTML5 games run instantly in your browser — no download, no signup, no plugins." } },
        { "@type": "Question", "name": "Are these different from the GBA emulator games?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. These are native browser games provided by Embed.Games. For retro Game Boy titles, visit the emulator library on the homepage." } }
      ]
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": SITE.url },
        { "@type": "ListItem", "position": 2, "name": "HTML5 Games", "item": `${SITE.url}/games` },
        { "@type": "ListItem", "position": 3, "name": "Action", "item": `${SITE.url}/games/action` }
      ]
    }
  ]
};
---
<BaseLayout title="HTML5 Action Shooters Online Free (3) | EggerMath" description="Best HTML5 action shooters: Johnny Trigger, Bowmasters, Crush the Castle. Play all 3 free in your browser." canonical={`${SITE.url}/games/action`} jsonLd={jsonLd}>
<main class="main" style="max-width:1200px;margin:0 auto;padding:12px 16px 24px">
  <nav style="font-size:12px;margin:4px 2px 10px"><a href="/" style="color:#c4a35a;text-decoration:none">Home</a> <span>›</span> <a href="/games" style="color:#c4a35a;text-decoration:none">HTML5 Games</a> <span>›</span> <span>Action</span></nav>
  <h1 style="font-size:1.6rem;margin:0 0 4px">Action Shooters <span style="color:#c4a35a">({list.length})</span></h1>
  <p style="color:#888;font-size:0.85rem;margin:0 0 14px">🎯 {list.length} shooters · 📱 mobile ready · ⚡ instant play — no download, no signup.</p>

  <div class="dm-mosaic">
    {featured && (
      <a href={`/games/${featured.slug}/`} class="dm-tile dm-big">
        <img src={featured.thumbnail} alt={`Play ${featured.title} online`} loading="eager" width="800" height="450" />
        <span class="dm-flag">🔥 Featured</span>
        <span class="dm-go">▶</span>
        <span class="dm-cap"><strong>{featured.title}</strong><em>Play free →</em></span>
      </a>
    )}
    {rest.map(g => (
      <a href={`/games/${g.slug}/`} class="dm-tile">
        <img src={g.thumbnail} alt={`Play ${g.title} online`} loading="lazy" width="400" height="225" />
        <span class="dm-go">▶</span>
        <span class="dm-cap"><strong>{g.title}</strong><em>Play free →</em></span>
      </a>
    ))}
  </div>

  <p style="color:#aaa;font-size:0.9rem;line-height:1.7;max-width:760px;margin:18px 0 0">Stunt assassins, archery duels, and castle sieges — free HTML5 shooters that run instantly in your browser on EggerMath. Looking for retro Game Boy titles instead? Visit the <a href="/" style="color:#c4a35a">emulator library</a>.</p>

  <div style="display:flex;flex-wrap:wrap;gap:8px;margin:14px 0 4px">
    <a href="/games" style="color:#c4a35a;text-decoration:none;font-size:0.8rem;padding:7px 14px;border:1px solid rgba(196,163,90,0.3);border-radius:999px;">🎮 All HTML5 Games</a>
    <a href="/best-action-gba-games" style="color:#c4a35a;text-decoration:none;font-size:0.8rem;padding:7px 14px;border:1px solid rgba(196,163,90,0.3);border-radius:999px;">⚔️ GBA Action</a>
    <a href="/" style="color:#c4a35a;text-decoration:none;font-size:0.8rem;padding:7px 14px;border:1px solid rgba(196,163,90,0.3);border-radius:999px;">🕹️ Emulator Library</a>
  </div>

  <h2 style="font-size:1.2rem;margin:22px 0 8px;color:#c4a35a">FAQ</h2>
  <details style="padding:8px 0;border-bottom:1px solid rgba(255,255,255,0.06)"><summary style="cursor:pointer;font-weight:600;color:#f0ebe0">What are the best free HTML5 shooters?</summary><p style="color:#aaa;font-size:14px;margin-top:6px">Johnny Trigger (stunts), Bowmasters (archery), Crush the Castle (sieges).</p></details>
  <details style="padding:8px 0;border-bottom:1px solid rgba(255,255,255,0.06)"><summary style="cursor:pointer;font-weight:600;color:#f0ebe0">Do they work on mobile?</summary><p style="color:#aaa;font-size:14px;margin-top:6px">Yes — touch controls in mobile Chrome and Safari, landscape recommended.</p></details>
  <details style="padding:8px 0;border-bottom:1px solid rgba(255,255,255,0.06)"><summary style="cursor:pointer;font-weight:600;color:#f0ebe0">Do I need to download anything?</summary><p style="color:#aaa;font-size:14px;margin-top:6px">No — everything runs instantly in your browser.</p></details>
  <details style="padding:8px 0;border-bottom:1px solid rgba(255,255,255,0.06)"><summary style="cursor:pointer;font-weight:600;color:#f0ebe0">How is this different from the emulator games?</summary><p style="color:#aaa;font-size:14px;margin-top:6px">These are native browser games. For Game Boy titles, visit the <a href="/" style="color:#c4a35a">emulator library</a>.</p></details>
</main>
</BaseLayout>

<style>
  /* DuckMath-style dense mosaic, EggerMath dark/gold theme */
  .dm-mosaic { display: grid; grid-template-columns: repeat(4, 1fr); grid-auto-rows: 150px; gap: 10px; }
  .dm-tile { position: relative; border-radius: 14px; overflow: hidden; display: block; border: 1px solid rgba(255,255,255,0.07); transition: transform 0.15s, border-color 0.15s, box-shadow 0.15s; background: #111; }
  .dm-tile:hover { transform: scale(1.03); border-color: rgba(196,163,90,0.55); box-shadow: 0 8px 28px rgba(0,0,0,0.5); z-index: 2; }
  .dm-tile img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .dm-big { grid-column: span 2; grid-row: span 2; }
  .dm-flag { position: absolute; top: 10px; left: 10px; background: #c4a35a; color: #0d0d0d; font-size: 0.7rem; font-weight: 800; padding: 4px 10px; border-radius: 999px; }
  .dm-go { position: absolute; inset: 0; margin: auto; width: 52px; height: 52px; border-radius: 50%; background: rgba(13,13,13,0.7); color: #c4a35a; font-size: 1.2rem; display: flex; align-items: center; justify-content: center; opacity: 0; transition: opacity 0.15s; pointer-events: none; }
  .dm-tile:hover .dm-go { opacity: 1; }
  .dm-cap { position: absolute; left: 0; right: 0; bottom: 0; padding: 22px 10px 8px; background: linear-gradient(transparent, rgba(0,0,0,0.85)); display: flex; flex-direction: column; }
  .dm-cap strong { color: #fff; font-size: 0.82rem; line-height: 1.25; }
  .dm-cap em { color: #c4a35a; font-style: normal; font-size: 0.7rem; font-weight: 700; }
  .dm-big .dm-cap strong { font-size: 1.15rem; }
  @media (max-width: 760px) {
    .dm-mosaic { grid-template-columns: repeat(2, 1fr); grid-auto-rows: 140px; gap: 8px; }
    .dm-go { opacity: 1; width: 44px; height: 44px; }
  }
</style>
