---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../data/games.js';
import { html5Games, html5Categories } from '../../data/html5-games.js';

const [featured, ...rest] = html5Games;

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ItemList",
      "name": "Free HTML5 Games to Play Online",
      "description": "Free HTML5 action and shooter games you can play in your browser with no download.",
      "itemListElement": html5Games.map((g, i) => ({
        "@type": "ListItem",
        "position": i + 1,
        "item": { "@type": "VideoGame", "name": g.title, "url": `${SITE.url}/games/${g.slug}/`, "genre": "Action", "applicationCategory": "Game" }
      }))
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": SITE.url },
        { "@type": "ListItem", "position": 2, "name": "HTML5 Games", "item": `${SITE.url}/games` }
      ]
    }
  ]
};
---
<BaseLayout title="HTML5 Games Online Free — Action Shooters | EggerMath" description="Play free HTML5 action shooters online: Johnny Trigger, Bowmasters, castle sieges. No download, mobile-friendly." canonical={`${SITE.url}/games`} jsonLd={jsonLd}>
<main class="main" style="max-width:1200px;margin:0 auto;padding:12px 16px 24px">
  <nav style="font-size:12px;margin:4px 2px 10px"><a href="/" style="color:#c4a35a;text-decoration:none">Home</a> <span>›</span> <span>HTML5 Games</span></nav>
  <h1 style="font-size:1.6rem;margin:0 0 4px">HTML5 Games <span style="color:#c4a35a">({html5Games.length})</span></h1>
  <p style="color:#888;font-size:0.85rem;margin:0 0 14px">🎯 Free shooters · 📱 mobile ready · ⚡ instant play — separate from the <a href="/" style="color:#c4a35a">GBA emulator library</a>.</p>

  <div class="dm-mosaic">
    {featured && (
      <a href={`/games/${featured.slug}/`} class="dm-tile dm-big">
        <img src={featured.thumbnail} alt={`Play ${featured.title} online`} loading="eager" width="800" height="450" />
        <span class="dm-flag">🔥 Featured</span>
        <span class="dm-go">▶</span>
        <span class="dm-cap"><strong>{featured.title}</strong><em>Play free →</em></span>
      </a>
    )}
    {rest.map(g => (
      <a href={`/games/${g.slug}/`} class="dm-tile">
        <img src={g.thumbnail} alt={`Play ${g.title} online`} loading="lazy" width="400" height="225" />
        <span class="dm-go">▶</span>
        <span class="dm-cap"><strong>{g.title}</strong><em>Play free →</em></span>
      </a>
    ))}
    <a href="/games/action" class="dm-tile dm-more">
      <span class="dm-more-in"><strong>Action Shooters</strong><em>Browse category →</em></span>
    </a>
  </div>

  <h2 style="font-size:1.2rem;margin:22px 0 10px;color:#c4a35a">Categories</h2>
  <div style="display:flex;flex-wrap:wrap;gap:8px;">
    {html5Categories.map(c => (
      <a href={`/games/${c.slug}`} style="color:#c4a35a;text-decoration:none;font-size:0.85rem;padding:8px 16px;border:1px solid rgba(196,163,90,0.3);border-radius:999px;">🎯 {c.title}</a>
    ))}
    <a href="/" style="color:#c4a35a;text-decoration:none;font-size:0.85rem;padding:8px 16px;border:1px solid rgba(196,163,90,0.3);border-radius:999px;">🕹️ GBA Emulator</a>
  </div>
</main>
</BaseLayout>

<style>
  .dm-mosaic { display: grid; grid-template-columns: repeat(4, 1fr); grid-auto-rows: 150px; gap: 10px; }
  .dm-tile { position: relative; border-radius: 14px; overflow: hidden; display: block; border: 1px solid rgba(255,255,255,0.07); transition: transform 0.15s, border-color 0.15s, box-shadow 0.15s; background: #111; }
  .dm-tile:hover { transform: scale(1.03); border-color: rgba(196,163,90,0.55); box-shadow: 0 8px 28px rgba(0,0,0,0.5); z-index: 2; }
  .dm-tile img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .dm-big { grid-column: span 2; grid-row: span 2; }
  .dm-flag { position: absolute; top: 10px; left: 10px; background: #c4a35a; color: #0d0d0d; font-size: 0.7rem; font-weight: 800; padding: 4px 10px; border-radius: 999px; }
  .dm-go { position: absolute; inset: 0; margin: auto; width: 52px; height: 52px; border-radius: 50%; background: rgba(13,13,13,0.7); color: #c4a35a; font-size: 1.2rem; display: flex; align-items: center; justify-content: center; opacity: 0; transition: opacity 0.15s; pointer-events: none; }
  .dm-tile:hover .dm-go { opacity: 1; }
  .dm-cap { position: absolute; left: 0; right: 0; bottom: 0; padding: 22px 10px 8px; background: linear-gradient(transparent, rgba(0,0,0,0.85)); display: flex; flex-direction: column; }
  .dm-cap strong { color: #fff; font-size: 0.82rem; line-height: 1.25; }
  .dm-cap em { color: #c4a35a; font-style: normal; font-size: 0.7rem; font-weight: 700; }
  .dm-big .dm-cap strong { font-size: 1.15rem; }
  .dm-more { background: #141414; display: flex; align-items: center; justify-content: center; }
  .dm-more-in { display: flex; flex-direction: column; gap: 4px; text-align: center; padding: 12px; }
  .dm-more-in strong { color: #f0ebe0; font-size: 0.95rem; }
  .dm-more-in em { color: #c4a35a; font-style: normal; font-size: 0.75rem; font-weight: 700; }
  @media (max-width: 760px) {
    .dm-mosaic { grid-template-columns: repeat(2, 1fr); grid-auto-rows: 140px; gap: 8px; }
    .dm-go { opacity: 1; width: 44px; height: 44px; }
  }
</style>
