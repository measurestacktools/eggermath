---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../data/games.js';
import { html5Games, html5Categories } from '../../data/html5-games.js';

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ItemList",
      "name": "Free HTML5 Games to Play Online",
      "description": "Free HTML5 action and shooter games you can play in your browser with no download.",
      "itemListElement": html5Games.map((g, i) => ({
        "@type": "ListItem",
        "position": i + 1,
        "item": { "@type": "VideoGame", "name": g.title, "url": `${SITE.url}/games/${g.slug}/`, "genre": "Action", "applicationCategory": "Game" }
      }))
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": SITE.url },
        { "@type": "ListItem", "position": 2, "name": "HTML5 Games", "item": `${SITE.url}/games` }
      ]
    }
  ]
};
---
<BaseLayout title="HTML5 Games Online Free — Action Shooters | EggerMath" description="Play free HTML5 action shooters online: Johnny Trigger, Bowmasters, castle sieges. No download, mobile-friendly." canonical={`${SITE.url}/games`} jsonLd={jsonLd}>
<main class="main" style="max-width:960px;margin:0 auto;padding:24px">
  <nav style="font-size:12px;margin-bottom:12px"><a href="/" style="color:#c4a35a;text-decoration:none">Home</a> <span>›</span> <span>HTML5 Games</span></nav>
  <h1>HTML5 Games — Play Free Online</h1>
  <p style="color:#aaa;margin-bottom:24px">Free browser shooters and action games, officially embedded and playable instantly on <a href="/" style="color:#c4a35a">EggerMath</a>. No download, no signup — separate from the <a href="/" style="color:#c4a35a">GBA/GBC/GB emulator library</a>.</p>

  <h2 style="font-size:1.3rem;margin:24px 0 12px;color:#c4a35a">Categories</h2>
  <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:16px;margin-bottom:24px">
    {html5Categories.map(c => (
      <a href={`/games/${c.slug}`} style="text-decoration:none;color:#f0ebe0;background:#111;border:1px solid #1e1e22;border-radius:12px;padding:20px;display:block">
        <div style="font-size:1.1rem;font-weight:700;color:#c4a35a;margin-bottom:6px">{c.title}</div>
        <div style="color:#aaa;font-size:14px">{c.description}</div>
      </a>
    ))}
  </div>

  <h2 style="font-size:1.3rem;margin:24px 0 12px;color:#c4a35a">All HTML5 Games</h2>
  <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:16px">
    {html5Games.map(g => (
      <a href={`/games/${g.slug}/`} style="text-decoration:none;color:#f0ebe0;background:#111;border:1px solid #1e1e22;border-radius:12px;overflow:hidden;display:block">
        <img src={g.thumbnail} alt={`Play ${g.title} online`} loading="lazy" width="400" height="225" style="width:100%;aspect-ratio:16/9;object-fit:cover;display:block" />
        <div style="padding:12px"><div style="font-weight:700">{g.title}</div><div style="color:#aaa;font-size:13px;margin-top:4px">Action shooter · Mobile ready</div></div>
      </a>
    ))}
  </div>
</main>
</BaseLayout>
