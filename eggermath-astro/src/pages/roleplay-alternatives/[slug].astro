---
import GeneratorLayout from '../../layouts/GeneratorLayout.astro';
import { SITE } from '../../data/games.js';
import { CHAT_URL, chatRow, roleplayCompetitors } from '../../data/roleplay-competitors.js';

export function getStaticPaths() {
  return roleplayCompetitors.map((tool, i) => ({
    params: { slug: tool.slug },
    props: {
      tool,
      others: [1, 2, 3].map((n) => roleplayCompetitors[(i + n) % roleplayCompetitors.length]),
    },
  }));
}

const { tool, others } = Astro.props;
const PAGE_URL = `${SITE.url}/roleplay-alternatives/${tool.slug}`;
const TITLE = `${tool.name} Alternative for AI Roleplay (2026) | EggerMath`;
const DESC = `Looking for a ${tool.name} alternative? What it does well, where it limits free play, and the no-account, no-cap option for SFW roleplay.`;

const faq = [
  ...tool.faq,
  {
    q: `What is the best ${tool.name} alternative for long roleplay?`,
    a: `A chat with no message cap and per-character memory. ${tool.name} limits free use through ${tool.cap.toLowerCase()}, and its memory is ${tool.memory.toLowerCase()}. A local-memory chat keeps the whole story instead.`,
  },
  {
    q: `Can I move my ${tool.name} character somewhere else?`,
    a: 'Yes, at the level of the description. Copy the character definition, paste it into the new chat as one message, and the new character card is built from it. Chat history itself does not transfer, but the character does.',
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      name: TITLE,
      url: PAGE_URL,
      description: DESC,
      dateModified: '2026-11-23',
      isPartOf: { '@type': 'WebSite', name: SITE.name, url: SITE.url },
      breadcrumb: {
        '@type': 'BreadcrumbList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
          {
            '@type': 'ListItem',
            position: 2,
            name: 'AI Roleplay Character Alternatives',
            item: `${SITE.url}/ai-roleplay-character-alternatives`,
          },
          { '@type': 'ListItem', position: 3, name: tool.name, item: PAGE_URL },
        ],
      },
    },
    {
      '@type': 'FAQPage',
      mainEntity: faq.map((item) => ({
        '@type': 'Question',
        name: item.q,
        acceptedAnswer: { '@type': 'Answer', text: item.a },
      })),
    },
    {
      '@type': 'SoftwareApplication',
      name: tool.name,
      url: tool.url,
      applicationCategory: 'EntertainmentApplication',
      operatingSystem: tool.platform,
    },
  ],
};
---

<GeneratorLayout
  title={TITLE}
  description={DESC}
  canonical={PAGE_URL}
  jsonLd={jsonLd}
  crumbs={[
    { name: 'Home', href: '/' },
    { name: 'Roleplay Alternatives', href: '/ai-roleplay-character-alternatives' },
    { name: tool.name },
  ]}
>
  <section class="gen-hero">
    <p class="gen-kicker">{tool.name} alternative</p>
    <h1>{tool.name} Alternative for AI Roleplay Character Play</h1>
    <p class="gen-lede">{tool.intro[0]}</p>
    <div class="gen-cta">
      <a class="gen-btn" href={CHAT_URL}>Play without an account</a>
      <a class="gen-btn gen-btn--ghost" href={tool.url} target="_blank" rel="nofollow noopener">
        Visit {tool.domain}
      </a>
    </div>
  </section>

  <p class="gen-byline" style="margin-top:20px">
    Reviewed by the EggerMath editorial team, 23 November 2026, from {tool.name}'s public pages.
    {tool.name} is a third-party platform; limits and policies change. Not sponsored.
  </p>

  <section class="gen-section">
    <h2>{tool.name} at a glance</h2>
    <ul class="gen-facts">
      {tool.facts.map(([label, value]) => (
        <li><b>{label}</b>{value}</li>
      ))}
      <li><b>Account</b>{tool.signup}</li>
      <li><b>Free cap</b>{tool.cap}</li>
      <li><b>Memory</b>{tool.memory}</li>
      <li><b>Policy</b>{tool.policy}</li>
      <li><b>Pricing</b>{tool.pricing}</li>
    </ul>
  </section>

  <section class="gen-section">
    <h2>Why people look for a {tool.name} alternative</h2>
    {tool.intro.slice(1).map((p) => <p>{p}</p>)}
    <div class="gen-grid" style="margin-top:20px">
      {tool.limits.map(([title, text]) => (
        <article class="gen-card">
          <h3>{title}</h3>
          <p>{text}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="gen-section">
    <h2>What {tool.name} does well</h2>
    <ul class="gen-list">
      {tool.strengths.map(([title, text]) => (
        <li><strong>{title}.</strong> {text}</li>
      ))}
    </ul>
  </section>

  <section class="gen-section">
    <h2>Stay or switch?</h2>
    <div class="gen-grid">
      <article class="gen-card">
        <h3>Stay with {tool.name} if</h3>
        <p>{tool.stayIf}</p>
      </article>
      <article class="gen-card">
        <h3>Switch if</h3>
        <p>{tool.switchIf}</p>
      </article>
      <article class="gen-card">
        <h3>The switch costs you</h3>
        <p>
          {tool.name}'s catalogue and community do not come with you. What transfers is the
          character description and the quality of the scene.
        </p>
      </article>
    </div>
  </section>

  <section class="gen-section">
    <h2>{tool.name} vs a no-account character chat</h2>
    <div class="gen-table-wrap">
      <table class="gen-table">
        <thead>
          <tr>
            <th>What matters</th>
            <th>{tool.name}</th>
            <th>EggerMath character chat</th>
          </tr>
        </thead>
        <tbody>
          <tr><td>Account</td><td>{tool.signup}</td><td>{chatRow.signup}</td></tr>
          <tr><td>Free message cap</td><td>{tool.cap}</td><td>{chatRow.cap}</td></tr>
          <tr><td>Memory</td><td>{tool.memory}</td><td>{chatRow.memory}</td></tr>
          <tr><td>Content policy</td><td>{tool.policy}</td><td>{chatRow.policy}</td></tr>
          <tr><td>Price</td><td>{tool.pricing}</td><td>{chatRow.pricing}</td></tr>
        </tbody>
      </table>
    </div>
    <p class="gen-note">
      Publicly visible behaviour in November 2026, summarised, not quoted. Verify current terms
      on each platform.
    </p>
  </section>

  <section class="gen-section">
    <h2>How to move a character across</h2>
    <ol class="gen-steps">
      <li>
        <strong>Copy the description.</strong> Take the personality, greeting and any rules you
        wrote for the character. That text is the portable part.
      </li>
      <li>
        <strong>Paste it as one message.</strong> In the new chat, describe the character and
        where the scene begins. The card and the opening line are built from it.
      </li>
      <li>
        <strong>Reopen the scene where you left it.</strong> Summarise the last event in one
        sentence instead of replaying the whole history; the memory picks up from there.
      </li>
    </ol>
    <p class="gen-inline-cta">
      <a href={CHAT_URL}>Create the character in the free chat</a> and continue the story.
    </p>
  </section>

  <section class="gen-section">
    <h2>Other roleplay alternatives</h2>
    <ul class="gen-links">
      {others.map((o) => (
        <li>
          <a href={`/roleplay-alternatives/${o.slug}`}>{o.name} alternative</a> — {o.tagline}
        </li>
      ))}
      <li><a href="/ai-roleplay-character-alternatives">Full comparison of all six platforms</a></li>
      <li><a href="/ai-roleplay-character-play">What roleplay character play needs to work</a></li>
    </ul>
  </section>

  <section class="gen-section">
    <h2>{tool.name} questions</h2>
    <div class="gen-faq">
      {faq.map((item) => (
        <details>
          <summary>{item.q}</summary>
          <p>{item.a}</p>
        </details>
      ))}
    </div>
  </section>

  <section class="gen-final">
    <h2>Start a scene that keeps going</h2>
    <p>No account, no cap, memory per character. The character is yours to describe.</p>
    <a class="gen-btn" href={CHAT_URL}>Open the free character chat</a>
  </section>
</GeneratorLayout>
