---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../data/games.js';
import { blogPosts } from '../../data/blog-posts.js';

export function getStaticPaths() {
  return blogPosts.map(post => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": post.title,
  "description": post.desc,
  "datePublished": post.date,
  "author": { "@type": "Organization", "name": "EggerMath" },
  "publisher": { "@type": "Organization", "name": "EggerMath", "url": SITE.url }
};
---
<BaseLayout title={`${post.title} | EggerMath Blog`} description={post.desc} canonical={`${SITE.url}/blog/${post.slug}`} jsonLd={jsonLd}>
<main style="max-width:800px;margin:0 auto;padding:24px">
  <a href="/blog" style="color:#c4a35a;text-decoration:none;font-size:14px">← Back to Blog</a>
  <span style="color:#555;font-size:12px;margin-left:12px">{post.date}</span>

  <h1 style="font-size:2rem;margin:16px 0 8px">{post.title}</h1>
  <p style="color:#aaa;margin-bottom:24px">{post.desc}</p>

  <Fragment set:html={post.body} />

  {post.relatedGames.length > 0 && (
    <div style="margin-top:2rem;padding:1.5rem;background:var(--bg-surface);border-radius:var(--radius-md);">
      <h3 style="margin:0 0 0.5rem">Related Games</h3>
      <div style="display:flex;gap:1rem;flex-wrap:wrap;margin-top:1rem;">
        {post.relatedGames.map(g => (
          <a href={`/${g.slug}`} style="color:var(--accent-amber);">{g.name}</a>
        ))}
      </div>
    </div>
  )}

  <div style="margin-top:32px;padding:20px;background:#111;border:1px solid #1e1e22;border-radius:12px">
    <h2 style="font-size:1.1rem;margin-bottom:8px">Play on EggerMath Now</h2>
    <p style="color:#aaa;font-size:14px;margin-bottom:12px">All games are free to play in your browser. No download, no signup.</p>
    <a href="/" style="color:#c4a35a;text-decoration:none;font-weight:700">Browse All Games →</a>
  </div>

  {post.relatedPosts.length > 0 && (
    <div style="margin-top:32px">
      <h2 style="font-size:1.1rem;margin-bottom:8px">Related Posts</h2>
      <ul style="padding-left:20px">
        {post.relatedPosts.map(rp => (
          <li><a href={`/blog/${rp.slug}`} style="color:#c4a35a;text-decoration:none">{rp.title}</a></li>
        ))}
      </ul>
    </div>
  )}
</main>
</BaseLayout>
