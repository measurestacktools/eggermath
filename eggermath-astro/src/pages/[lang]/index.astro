---
import EmulatorLayout from '../../layouts/EmulatorLayout.astro';
import NoscriptFallback from '../../components/NoscriptFallback.astro';
import UploadArea from '../../components/UploadArea.astro';
import ContinueBar from '../../components/ContinueBar.astro';
import GameCard from '../../components/GameCard.astro';
import { games, SITE } from '../../data/games.js';
import { langNames } from '../../data/translations.js';

export function getStaticPaths() {
  const langs = ["pt-BR","es","ja","de","fr","ru","ko","it","id","ar","zh-CN","zh-TW","hi","th","vi","tr","pl","nl"];
  return langs.map(lang => ({ params: { lang }, props: { lang } }));
}

const { lang } = Astro.props;
const langName = langNames[lang] || lang;
const baseUrl = SITE.url;

const titleMap = {
  'pt-BR': 'Emulador GBA Online — Jogue 49 Jogos Gratis',
  'es': 'Emulador GBA Online — Juega 49 Juegos Gratis',
  'ja': 'GBAエミュレータオンライン — 49ゲーム無料',
  'de': 'GBA Emulator Online — 49 Spiele Kostenlos',
  'fr': 'Émulateur GBA En Ligne — 49 Jeux Gratuits',
  'ru': 'GBA Эмулятор Онлайн — 49 Игры Бесплатно',
  'ko': 'GBA 에뮬레이터 온라인 — 49게임 무료',
  'it': 'Emulatore GBA Online — 49 Giochi Gratis',
  'id': 'Emulator GBA Online — 49 Game Gratis',
  'ar': 'محاكي GBA اونلاين — 49 لعبة مجانا',
  'zh-CN': 'GBA模拟器在线 — 49款游戏免费',
  'zh-TW': 'GBA模擬器線上 — 49款遊戲免費',
  'hi': 'GBA एमुलेटर ऑनलाइन — 49 गेम मुफ्त',
  'th': 'จำลอง GBA ออนไลน์ — 49 เกมฟรี',
  'vi': 'Trình giả lập GBA Trực tuyến — 49 Game Miễn Phí',
  'tr': 'GBA Emülatör Çevrimiçi — 49 Oyun Ücretsiz',
  'pl': 'Emulator GBA Online — 49 Gry za Darmo',
  'nl': 'GBA Emulator Online — 49 Spelletjes Gratis',
};

const descMap = {
  'pt-BR': 'Jogue 49 jogos classicos de GBA, GBC e GB gratis no navegador. Pokemon, Zelda, Mario e mais.',
  'es': 'Juega 49 juegos classicos de GBA, GBC y GB gratis en el navegador. Pokemon, Zelda, Mario y mas.',
  'ja': 'GBA、GBC、GBのクラシックゲーム49本をブラウザで無料プレイ。ポケモン、ゼルダ、マリオなど。',
  'de': 'Spiele 49 klassische GBA, GBC und GB Spiele kostenlos im Browser. Pokemon, Zelda, Mario und mehr.',
  'fr': 'Jouez a 49 jeux classiques GBA, GBC et GB gratuitement. Pokemon, Zelda, Mario et plus.',
  'ru': 'Играйте в 49 классические игры GBA, GBC и GB бесплатно в браузере. Pokemon, Zelda, Mario и другие.',
  'ko': 'GBA, GBC, GB 클래식 게임 49개를 브라우저에서 무료로 플레이하세요. 포켓몬, 젤다, 마리오 등.',
  'it': 'Gioca ai 49 classici giochi GBA, GBC e GB gratis nel browser. Pokemon, Zelda, Mario e altro.',
  'id': 'Mainkan 49 game klasik GBA, GBC, dan GB gratis di browser. Pokemon, Zelda, Mario dan lainnya.',
  'ar': 'العب 49 لعبة كلاسيكية من GBA و GBC و GB مجانا في المتصفح. Pokemon, Zelda, Mario والمزيد.',
  'zh-CN': '在浏览器中免费玩49款经典GBA、GBC、GB游戏。口袋妖怪、塞尔达、马里奥等。',
  'zh-TW': '在瀏覽器中免費遊玩49款經典GBA、GBC、GB遊戲。口袋妖怪、薩爾達、瑪利歐等。',
  'hi': 'ब्राउज़र में 49 क्लासिक GBA, GBC, GB गेम मुफ्त खेलें। पोकेमोन, ज़ेल्डा, मारियो और बहुत कुछ।',
  'th': 'เล่นเกมคลาสสิก GBA, GBC, GB 49 เกมฟรีในเบราว์เซอร์ โปเกมอน, เซลด้า, มาริโอ้ และอื่นๆ',
  'vi': 'Chơi 49 game kinh điển GBA, GBC, GB miễn phí trên trình duyệt. Pokemon, Zelda, Mario và nhiều hơn nữa.',
  'tr': 'Tarayicinizda 49 klasik GBA, GBC, GB oyununu ucretsiz oynayin. Pokemon, Zelda, Mario ve daha fazlasi.',
  'pl': 'Graj w 49 klasyczne gry GBA, GBC i GB za darmo w przegladarce. Pokemon, Zelda, Mario i wiecej.',
  'nl': 'Speel 49 klassieke GBA, GBC en GB spelletjes gratis in je browser. Pokemon, Zelda, Mario en meer.',
};

const pageTitle = titleMap[lang] || 'Play GBA, GBC & GB Games Online Free';
const pageDesc = descMap[lang] || SITE.description;

const supportedLangsList = ["en","pt-BR","es","ja","de","fr","ru","ko","it","id","ar","zh-CN","zh-TW","hi","th","vi","tr","pl","nl"];
const alternateLinks = supportedLangsList.map(l => {
  const href = l === 'en' ? `${baseUrl}/` : `${baseUrl}/${l}/`;
  return `<link rel="alternate" hreflang="${l}" href="${href}" />`;
}).join('\n  ');

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": SITE.name,
  "url": `${baseUrl}/${lang}/`,
  "description": pageDesc,
  "inLanguage": lang,
};
---

<EmulatorLayout
  title={pageTitle}
  description={pageDesc}
  canonical={`${baseUrl}/${lang}`}
  jsonLd={jsonLd}
  hreflangHtml={alternateLinks}
>
  <NoscriptFallback />
  <main class="main">
    <UploadArea />
    <ContinueBar />
    <div class="pre-game-content" id="pre-game-content">
      <section class="browse-section">
        <div class="browse-header">
          <h1>{pageTitle}</h1>
          <span class="badge">{langName}</span>
        </div>
        <p class="browse-sub">{pageDesc}</p>
        <div class="games-grid" id="games-grid">
          {games.map(game => (
            <GameCard
              title={game.title}
              genre={game.genre}
              slug={`${lang}/${game.slug}`}
              img={game.img}
              mega={game.mega}
            />
          ))}
        </div>
      </section>
    </div>
  </main>
</EmulatorLayout>

<script is:inline src="/ios-compat.js"></script>
<script is:inline src="https://unpkg.com/megajs@1/dist/main.browser-umd.js"></script>
<script>
import '../../scripts/emulator.js';
</script>
