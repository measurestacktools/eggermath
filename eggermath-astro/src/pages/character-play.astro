---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../data/games.js';
import { STORIES, STORY_CATEGORIES } from '../data/stories.js';

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      name: 'Character Stories — EggerMath',
      url: `${SITE.url}/character-play`,
      description:
        'Hand-written branching stories with fictional characters. Choose a path, reach an ending. No AI chat, no free-text input, no account.',
      isPartOf: { '@type': 'WebSite', name: SITE.name, url: SITE.url },
    },
    {
      '@type': 'FAQPage',
      mainEntity: [
        {
          '@type': 'Question',
          name: 'Are these stories AI-generated?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'No. Every scene is hand-written and reviewed. There is no free-text box and no language model, so the stories cannot improvise or produce content we did not publish.',
          },
        },
        {
          '@type': 'Question',
          name: 'Do I need an account or pay?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'No account, no payment and no email. The stories run entirely in your browser.',
          },
        },
        {
          '@type': 'Question',
          name: 'What content is inside?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Adventure, mystery, low fantasy, comedy, history and science fiction. There is no romance, no sexual content, no gore and no gambling. Peril is mild and failure endings are gentle.',
          },
        },
      ],
    },
  ],
};
---

<BaseLayout
  title="Character Stories — Hand-Written Branching Fiction | EggerMath"
  description="Choose a character and a path in short hand-written branching stories: adventure, mystery, low fantasy, comedy, history and sci-fi. No AI chat, no free-text input, no account."
  canonical={`${SITE.url}/character-play`}
  jsonLd={jsonLd}
  showAds={false}
>
  <h1 class="cp-sr">Character Stories — hand-written branching fiction</h1>
  <main class="cp-app" id="cp-app" data-view="gallery" data-has-story="0">
    <!-- ── Left rail: story picker ───────────────────────────────────── -->
    <aside class="cp-side" id="cp-side" aria-label="Story picker">
      <div class="cp-side-top">
        <button type="button" class="cp-new" id="cp-new">
          <span aria-hidden="true">💬</span>
          <span>new story / character</span>
        </button>
        <button
          type="button"
          class="cp-menu-btn"
          id="cp-menu-close"
          aria-label="Back to story list"
        >←</button>
      </div>

      <div class="cp-side-scroll">
        <label class="cp-search">
          <span class="cp-sr">Search stories</span>
          <input
            id="cp-search"
            type="search"
            placeholder="Search characters or themes…"
            autocomplete="off"
          />
        </label>

        <div class="cp-filters" id="cp-filters" role="group" aria-label="Filter by category">
          <button type="button" class="cp-chip is-active" data-category="all" aria-pressed="true">All</button>
          {STORY_CATEGORIES.map((cat) => (
            <button type="button" class="cp-chip" data-category={cat.id} aria-pressed="false">{cat.label}</button>
          ))}
        </div>

        <div class="cp-grid" id="cp-grid">
          {STORIES.map((story) => (
            <article
              class="cp-card"
              data-story-id={story.id}
              data-category={story.category}
              data-search={`${story.name} ${story.tagline} ${story.description} ${story.tags.join(' ')}`.toLowerCase()}
              style={`--cp-accent:${story.accent}`}
            >
              <span class="cp-avatar" aria-hidden="true">{story.emoji}</span>
              <div class="cp-card-body">
                <p class="cp-card-name">{story.name}</p>
                <p class="cp-card-sub">
                  {STORY_CATEGORIES.find((c) => c.id === story.category)?.label} · {story.minutes} min
                </p>
                <p class="cp-card-tag">{story.tagline}</p>
              </div>
              <button type="button" class="cp-card-open" data-start={story.id}>
                <span class="cp-sr">Start story with {story.name}</span>
                <span aria-hidden="true">›</span>
              </button>
            </article>
          ))}
        </div>
        <p class="cp-empty" id="cp-empty" hidden>No stories match that search. Try “mystery” or “history”.</p>

        <p class="cp-note">
          <strong>Note:</strong> these are hand-written stories, not a chatbot. There is no text box,
          no language model and no server. Your place in a story exists only in this tab.
        </p>
      </div>

      <div class="cp-side-actions">
        <a class="cp-side-btn" href="/sudoku"><span aria-hidden="true">🔢</span> Sudoku</a>
        <a class="cp-side-btn" href="#cp-about"><span aria-hidden="true">❔</span> About</a>
      </div>
    </aside>

    <!-- ── Transcript ────────────────────────────────────────────────── -->
    <section class="cp-main" aria-label="Story transcript">
      <header class="cp-head">
        <button type="button" class="cp-head-menu" id="cp-menu-open" aria-label="Open story list">≡</button>
        <span class="cp-head-avatar" id="cp-head-avatar" aria-hidden="true">📖</span>
        <div class="cp-head-text">
          <p class="cp-head-name" id="cp-head-name">Pick a story</p>
          <p class="cp-head-meta" id="cp-head-meta">Six hand-written stories · no AI</p>
        </div>
        <div class="cp-head-right">
          <span class="cp-badge">Hand-written</span>
          <a class="cp-head-link" href="/sudoku">Sudoku break</a>
        </div>
      </header>

      <div class="cp-log" id="cp-log" role="log" aria-live="polite" aria-label="Story so far">
        <div class="cp-placeholder" id="cp-placeholder">
          <p class="cp-placeholder-kicker">No story open</p>
          <h2>Character Stories</h2>
          <p>
            Pick a character on the left, then choose a reply at the bottom of the transcript. Every
            line is written and reviewed by a human — there is no free-text box and no model, so
            nothing here can improvise.
          </p>
          <ul class="cp-placeholder-list">
            <li>Adventure, mystery, low fantasy, comedy, history, sci-fi.</li>
            <li>Five to seven minutes each, with real endings.</li>
            <li>No romance, no gore, no gambling, no account.</li>
          </ul>
        </div>
      </div>

      <div class="cp-compose" id="cp-compose">
        <p class="cp-compose-label" id="cp-compose-label">Choose your reply</p>
        <div class="cp-choices" id="cp-choices"></div>

        <div class="cp-ending" id="cp-ending" hidden>
          <p class="cp-ending-kicker">Ending</p>
          <h2 id="cp-ending-title"></h2>
          <p id="cp-ending-text"></p>
          <div class="cp-ending-actions">
            <button type="button" class="cp-btn cp-btn--primary" id="cp-again">Read again</button>
            <button type="button" class="cp-btn" id="cp-another">Another story</button>
            <a class="cp-btn cp-btn--ghost" href="/sudoku">Try sudoku</a>
          </div>
        </div>

        <p class="cp-compose-foot">
          <span id="cp-progress">—</span>
          <span class="cp-compose-sep" aria-hidden="true">·</span>
          <span>choices only, no free text</span>
        </p>
      </div>

      <aside class="cp-break" id="cp-break" hidden aria-live="polite">
        <div>
          <p class="cp-break-title">You’ve been reading for 30 minutes</p>
          <p class="cp-break-text">
            Take a five-minute break if you like. A sudoku is a calm way to reset — no account, no
            pressure.
          </p>
        </div>
        <div class="cp-break-actions">
          <a class="cp-btn cp-btn--primary" href="/sudoku">Open sudoku</a>
          <button type="button" class="cp-btn" id="cp-break-dismiss">Keep reading</button>
        </div>
      </aside>
    </section>
  </main>

  <section class="cp-about" id="cp-about">
    <div class="cp-about-inner">
      <h2>What this is — and what it isn’t</h2>
      <div class="cp-about-grid">
        <div>
          <h3>It is</h3>
          <ul>
            <li>Hand-written branching fiction, reviewed before publishing.</li>
            <li>A short, finite story with an ending you can reach in one sitting.</li>
            <li>Free, account-free, and playable on a phone.</li>
          </ul>
        </div>
        <div>
          <h3>It isn’t</h3>
          <ul>
            <li>An AI chatbot — there is no free-text input and no model.</li>
            <li>A companion, dating or romance experience.</li>
            <li>A place to upload characters, images or personal information.</li>
          </ul>
        </div>
      </div>
      <p class="cp-about-note">
        Content: adventure, mystery, low fantasy, comedy, history and sci-fi. No sexual content, no
        romance, no gore, no gambling, no alcohol, and no occult practice. Peril stays mild and
        failure endings are gentle. If something still feels wrong for you or your family,
        <a href="/pages/contact">tell us</a>.
      </p>
      <p class="cp-about-note">
        These pages carry no advertising. The <a href="/sudoku">sudoku page</a> is supported by a
        display banner; the stories are not monetised.
      </p>
    </div>
  </section>

  <script type="application/json" id="cp-data" set:html={JSON.stringify(STORIES)}></script>
  <script>
    import '../scripts/character-play.js';
  </script>
</BaseLayout>

<style>
  /* ── Shell ─────────────────────────────────────────────────────────── */
  .cp-app {
    --cp-rail: 320px;
    --cp-line: #23252f;
    display: grid;
    grid-template-columns: var(--cp-rail) minmax(0, 1fr);
    height: calc(100vh - 57px);
    height: calc(100dvh - 57px);
    min-height: 560px;
    border-bottom: 1px solid var(--border-subtle);
    background: var(--bg-surface);
  }

  .cp-sr {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* ── Left rail ─────────────────────────────────────────────────────── */
  .cp-side {
    display: flex;
    flex-direction: column;
    min-height: 0;
    border-right: 1px solid var(--cp-line);
    background: #0d0f16;
  }

  .cp-side-top {
    display: flex;
    gap: 6px;
    padding: 10px;
    border-bottom: 1px solid var(--cp-line);
  }

  .cp-new {
    flex: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    min-height: 38px;
    padding: 8px 10px;
    border: 1px solid var(--cp-line);
    border-radius: 5px;
    background: #181a24;
    color: var(--text-primary);
    font-family: var(--font-sans);
    font-size: 0.82rem;
    font-weight: 600;
    cursor: pointer;
  }

  .cp-new:hover {
    border-color: var(--border-focus);
  }

  .cp-menu-btn,
  .cp-head-menu {
    display: none;
    width: 38px;
    min-height: 38px;
    border: 1px solid var(--cp-line);
    border-radius: 5px;
    background: #181a24;
    color: var(--text-primary);
    font-size: 1rem;
    cursor: pointer;
  }

  .cp-side-scroll {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    padding: 10px;
  }

  .cp-search input {
    width: 100%;
    min-height: 34px;
    padding: 7px 10px;
    border: 1px solid var(--cp-line);
    border-radius: 5px;
    background: #16181f;
    color: var(--text-primary);
    font: inherit;
    font-size: 0.8rem;
  }

  .cp-search input::placeholder {
    color: var(--text-tertiary);
  }

  .cp-search input:focus-visible {
    outline: 2px solid var(--border-focus);
    outline-offset: 1px;
  }

  .cp-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    margin: 8px 0 10px;
  }

  .cp-chip {
    padding: 4px 8px;
    border: 1px solid var(--cp-line);
    border-radius: 4px;
    background: transparent;
    color: var(--text-secondary);
    font-family: var(--font-sans);
    font-size: 0.7rem;
    font-weight: 600;
    cursor: pointer;
  }

  .cp-chip:hover {
    color: var(--text-primary);
    border-color: var(--border-focus);
  }

  .cp-chip.is-active {
    background: var(--accent-amber);
    border-color: var(--accent-amber);
    color: var(--text-inverse);
  }

  .cp-grid {
    display: grid;
    gap: 6px;
  }

  /* Thread cards (JS filters these, so `display` must not beat [hidden]). */
  .cp-card {
    display: grid;
    grid-template-columns: 44px minmax(0, 1fr) 20px;
    align-items: center;
    gap: 9px;
    padding: 8px;
    border: 1px solid var(--cp-line);
    border-radius: 6px;
    background: #14161e;
    cursor: pointer;
    transition: border-color 0.12s ease, background 0.12s ease;
  }

  .cp-card[hidden] {
    display: none;
  }

  .cp-card:hover {
    border-color: var(--cp-accent, var(--border-focus));
    background: #191c26;
  }

  .cp-card.is-active {
    border-color: var(--cp-accent, var(--accent-amber));
    background: color-mix(in srgb, var(--cp-accent, var(--accent-amber)) 12%, #14161e);
  }

  .cp-avatar {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--cp-line);
    border-radius: 6px;
    background: color-mix(in srgb, var(--cp-accent, var(--accent-amber)) 18%, transparent);
    font-size: 1.2rem;
    line-height: 1;
  }

  .cp-card-body {
    min-width: 0;
  }

  .cp-card-name {
    font-size: 0.84rem;
    font-weight: 700;
    color: var(--text-primary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .cp-card-sub {
    font-size: 0.66rem;
    color: var(--cp-accent, var(--accent-amber));
    font-weight: 600;
  }

  .cp-card-tag {
    margin-top: 2px;
    font-size: 0.68rem;
    color: var(--text-tertiary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .cp-card-open {
    width: 20px;
    height: 28px;
    border: 0;
    background: none;
    color: var(--text-secondary);
    font-size: 1.1rem;
    line-height: 1;
    cursor: pointer;
  }

  .cp-card:hover .cp-card-open {
    color: var(--text-primary);
  }

  .cp-empty {
    padding: 14px 4px;
    color: var(--text-tertiary);
    font-size: 0.78rem;
  }

  .cp-empty[hidden] {
    display: none;
  }

  .cp-note {
    margin-top: 10px;
    padding: 8px;
    border: 1px solid var(--cp-line);
    border-radius: 5px;
    color: var(--text-tertiary);
    font-size: 0.68rem;
    line-height: 1.5;
  }

  .cp-note strong {
    color: var(--text-secondary);
  }

  .cp-side-actions {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 6px;
    padding: 10px;
    border-top: 1px solid var(--cp-line);
  }

  .cp-side-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 5px;
    min-height: 34px;
    border: 1px solid var(--cp-line);
    border-radius: 5px;
    background: #181a24;
    color: var(--text-secondary);
    font-size: 0.74rem;
    font-weight: 600;
    text-decoration: none;
  }

  .cp-side-btn:hover {
    color: var(--text-primary);
    border-color: var(--border-focus);
  }

  /* ── Main column ───────────────────────────────────────────────────── */
  .cp-main {
    display: flex;
    flex-direction: column;
    min-width: 0;
    min-height: 0;
    background: var(--bg-surface);
  }

  .cp-head {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 14px;
    border-bottom: 1px solid var(--cp-line);
    background: #0d0f16;
  }

  .cp-head-avatar {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border: 1px solid var(--cp-line);
    border-radius: 5px;
    background: #181a24;
    font-size: 1rem;
  }

  .cp-head-text {
    min-width: 0;
    flex: 1;
  }

  .cp-head-name {
    font-size: 0.84rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  .cp-head-meta {
    font-size: 0.68rem;
    color: var(--text-tertiary);
  }

  .cp-head-right {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .cp-badge {
    padding: 3px 7px;
    border: 1px solid color-mix(in srgb, var(--accent-emerald) 45%, transparent);
    border-radius: 4px;
    color: var(--accent-emerald);
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .cp-head-link {
    color: var(--text-tertiary);
    font-size: 0.72rem;
    text-decoration: underline;
    text-underline-offset: 3px;
    white-space: nowrap;
  }

  /* ── Transcript ────────────────────────────────────────────────────── */
  .cp-log {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    padding: 16px 14px 8px;
    scroll-behavior: smooth;
  }

  .cp-placeholder {
    max-width: 460px;
    margin: 8vh auto 0;
    text-align: center;
    color: var(--text-secondary);
  }

  .cp-placeholder-kicker {
    color: var(--accent-emerald);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .cp-placeholder h2 {
    margin: 4px 0 10px;
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 4vw, 2.2rem);
    color: var(--text-primary);
  }

  .cp-placeholder p {
    font-size: 0.86rem;
    line-height: 1.65;
  }

  .cp-placeholder-list {
    margin: 14px 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 6px;
    font-size: 0.78rem;
    color: var(--text-tertiary);
  }

  /* Messages are created by character-play.js. */
  .cp-log :global(.cp-msg) {
    display: grid;
    grid-template-columns: 40px minmax(0, 1fr);
    gap: 9px;
    max-width: 860px;
    margin: 0 auto 14px;
  }

  .cp-log :global(.cp-msg-avatar) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border: 1px solid var(--cp-line);
    border-radius: 5px;
    background: color-mix(in srgb, var(--cp-accent, var(--accent-amber)) 16%, transparent);
    font-size: 1.05rem;
  }

  .cp-log :global(.cp-msg-name) {
    display: flex;
    align-items: baseline;
    gap: 6px;
    margin-bottom: 2px;
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  .cp-log :global(.cp-msg-kind) {
    font-size: 0.58rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-tertiary);
  }

  .cp-log :global(.cp-msg-text) {
    font-size: 0.88rem;
    line-height: 1.65;
    color: var(--text-primary);
    white-space: pre-line;
    overflow-wrap: anywhere;
  }

  .cp-log :global(.cp-msg--narrator) {
    grid-template-columns: minmax(0, 1fr);
    padding-left: 10px;
    border-left: 2px solid var(--cp-line);
  }

  .cp-log :global(.cp-msg--narrator .cp-msg-text) {
    color: var(--text-secondary);
    font-style: italic;
  }

  .cp-log :global(.cp-msg--me) {
    grid-template-columns: minmax(0, 1fr) 40px;
  }

  .cp-log :global(.cp-msg--me .cp-msg-avatar) {
    order: 2;
    background: #1b1e29;
  }

  .cp-log :global(.cp-msg--me .cp-msg-body) {
    order: 1;
    justify-self: end;
    max-width: 82%;
    padding: 8px 11px;
    border: 1px solid var(--cp-line);
    border-radius: 6px;
    background: #171a24;
  }

  .cp-log :global(.cp-msg--me .cp-msg-name) {
    justify-content: flex-end;
    color: var(--text-secondary);
  }

  .cp-log :global(.cp-msg--me .cp-msg-text) {
    color: var(--text-secondary);
  }

  .cp-log :global(.cp-divider) {
    display: flex;
    align-items: center;
    gap: 8px;
    max-width: 860px;
    margin: 4px auto 14px;
    color: var(--text-tertiary);
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .cp-log :global(.cp-divider::before),
  .cp-log :global(.cp-divider::after) {
    content: '';
    height: 1px;
    flex: 1;
    background: var(--cp-line);
  }

  /* ── Composer: choices, not text ───────────────────────────────────── */
  .cp-compose {
    border-top: 1px solid var(--cp-line);
    background: #0d0f16;
    padding: 10px 14px 8px;
  }

  .cp-compose-label,
  .cp-choices,
  .cp-ending,
  .cp-compose-foot {
    width: 100%;
    max-width: 860px;
    margin-left: auto;
    margin-right: auto;
  }

  .cp-compose-label {
    margin-bottom: 7px;
    color: var(--text-tertiary);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .cp-choices {
    display: grid;
    gap: 6px;
  }

  .cp-choices[hidden] {
    display: none;
  }

  .cp-compose :global(.cp-choice) {
    width: 100%;
    padding: 10px 12px;
    border: 1px solid var(--cp-line);
    border-radius: 5px;
    background: #16181f;
    color: var(--text-primary);
    font-family: var(--font-sans);
    font-size: 0.84rem;
    font-weight: 600;
    text-align: left;
    cursor: pointer;
    transition: border-color 0.12s ease, background 0.12s ease;
  }

  .cp-compose :global(.cp-choice:hover) {
    border-color: var(--accent-amber);
    background: #1b1e29;
  }

  .cp-compose :global(.cp-choice:focus-visible) {
