---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../data/games.js';

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebApplication',
      name: 'Slide Puzzle',
      url: `${SITE.url}/puzzle`,
      applicationCategory: 'GameApplication',
      operatingSystem: 'Any',
      browserRequirements: 'Requires JavaScript',
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      description:
        'Free sliding number puzzle. Arrange the tiles from 1 to 15 in order in the fewest moves. Works on mobile and desktop, no download.',
    },
    {
      '@type': 'FAQPage',
      mainEntity: [
        {
          '@type': 'Question',
          name: 'Is the slide puzzle free?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Yes. The puzzle is completely free, with no account and no download. It runs in your browser on phone, tablet or desktop.',
          },
        },
        {
          '@type': 'Question',
          name: 'Is every shuffle solvable?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Yes. The board is shuffled by playing hundreds of legal moves backwards from the solved state, so a solution always exists.',
          },
        },
        {
          '@type': 'Question',
          name: 'How do I play with a keyboard?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Use the arrow keys to slide the tile next to the empty square. Tap or click a tile on touch screens.',
          },
        },
      ],
    },
  ],
};
---

<BaseLayout
  title="Slide Puzzle — Free Number Puzzle Game | EggerMath"
  description="Play a free slide puzzle in your browser. Arrange the numbered tiles from 1 to 15 in the fewest moves. No download, works on mobile and desktop."
  canonical={`${SITE.url}/puzzle`}
  jsonLd={jsonLd}
>
  <main class="pz">
    <section class="pz-hero">
      <p class="pz-kicker">Puzzle</p>
      <h1>Slide puzzle</h1>
      <p class="pz-lede">
        Slide the tiles into order, 1 to 15, with the empty square in the bottom-right corner.
        No timer pressure, no download — just a board and your next move.
      </p>
    </section>

    <section class="pz-board-wrap" aria-label="Slide puzzle game">
      <div class="pz-stats">
        <div class="pz-stat">
          <span class="pz-stat-label">Moves</span>
          <strong id="pzMoves">0</strong>
        </div>
        <div class="pz-stat">
          <span class="pz-stat-label">Time</span>
          <strong id="pzTime">0:00</strong>
        </div>
        <div class="pz-stat">
          <span class="pz-stat-label">Best</span>
          <strong id="pzBest">—</strong>
        </div>
      </div>

      <div class="pz-board-shell">
        <div
          class="pz-board"
          id="pzBoard"
          role="grid"
          aria-label="Sliding number tiles"
          tabindex="0"
        >
        </div>

        <div class="pz-win" id="pzWin" role="status" aria-live="polite" hidden>
          <p class="pz-win-title">Solved</p>
          <p class="pz-win-sub" id="pzWinSub">—</p>
          <button class="pz-btn pz-btn--primary" id="pzWinAgain" type="button">Play again</button>
        </div>
      </div>

      <div class="pz-controls">
        <button class="pz-btn pz-btn--primary" id="pzNew" type="button">New game</button>
        <div class="pz-sizes" role="group" aria-label="Board size">
          <button class="pz-size" data-size="3" type="button">3×3</button>
          <button class="pz-size is-active" data-size="4" type="button">4×4</button>
          <button class="pz-size" data-size="5" type="button">5×5</button>
        </div>
      </div>

      <p class="pz-hint">Tap a tile next to the empty square, or use the arrow keys.</p>
    </section>

    <section class="pz-section">
      <h2>How to play</h2>
      <ol class="pz-steps">
        <li><strong>Slide, don't drag.</strong> Only tiles next to the empty square can move.</li>
        <li><strong>Build the top row first.</strong> Locking row one early turns a 4×4 into a much smaller problem.</li>
        <li><strong>Watch your last two rows.</strong> If the final two rows are stuck, you'll usually need to rotate a 2×2 block rather than fight it tile by tile.</li>
      </ol>
      <p class="pz-note">
        Every board is shuffled by playing legal moves backwards from the solved state, so it is
        always solvable — no impossible boards, ever.
      </p>
    </section>

    <section class="pz-section">
      <h2>Why a slide puzzle</h2>
      <div class="pz-cards">
        <article class="pz-card">
          <h3>Short sessions</h3>
          <p>A full board takes a few minutes. Perfect between games, on a commute, or while something loads.</p>
        </article>
        <article class="pz-card">
          <h3>Real focus</h3>
          <p>There is no luck and no timer you have to beat — just the board and the move you choose next.</p>
        </article>
        <article class="pz-card">
          <h3>Memory that stays</h3>
          <p>Your best result is saved in this browser, so you can come back and try to beat it.</p>
        </article>
      </div>
    </section>

    <section class="pz-section">
      <h2>Questions</h2>
      <div class="pz-faq">
        <details>
          <summary>Is the slide puzzle free?</summary>
          <p>Yes. No account, no download, no payment. It runs entirely in your browser.</p>
        </details>
        <details>
          <summary>Is every shuffle solvable?</summary>
          <p>Yes. The board is created by replaying legal moves backwards from the solved position, which guarantees a solution exists.</p>
        </details>
        <details>
          <summary>Does it work on a phone?</summary>
          <p>Yes. Tap tiles to slide them, and the board scales to fit the screen.</p>
        </details>
        <details>
          <summary>How is the best score stored?</summary>
          <p>In this browser's local storage, per board size. Clearing site data resets it.</p>
        </details>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .pz {
    max-width: 720px;
    margin: 0 auto;
    padding: 32px 20px 72px;
  }

  .pz-hero {
    text-align: center;
    margin-bottom: 28px;
  }

  .pz-kicker {
    margin-bottom: 8px;
    color: var(--accent-amber);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .pz-hero h1 {
    font-family: var(--font-display);
    font-size: clamp(1.9rem, 5vw, 2.6rem);
    letter-spacing: -0.02em;
  }

  .pz-lede {
    max-width: 520px;
    margin: 12px auto 0;
    color: var(--text-secondary);
    font-size: 0.94rem;
    line-height: 1.65;
  }

  /* ── Board ────────────────────────────────────────────────────────── */
  .pz-board-wrap {
    padding: 18px;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    background: linear-gradient(180deg, rgba(24, 26, 36, 0.9), rgba(17, 19, 27, 0.95));
    box-shadow: var(--shadow-md);
  }

  .pz-stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 8px;
    margin-bottom: 14px;
  }

  .pz-stat {
    padding: 8px 10px;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    background: rgba(0, 0, 0, 0.22);
    text-align: center;
  }

  .pz-stat-label {
    display: block;
    color: var(--text-tertiary);
    font-size: 0.64rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .pz-stat strong {
    display: block;
    margin-top: 2px;
    font-family: var(--font-mono);
    font-size: 0.95rem;
    color: var(--text-primary);
  }

  .pz-board-shell {
    position: relative;
  }

  .pz-board {
    position: relative;
    width: 100%;
    aspect-ratio: 1;
    border-radius: var(--radius-md);
    background: #0b0d14;
    overflow: hidden;
    outline: none;
    touch-action: manipulation;
  }

  .pz-board:focus-visible {
    box-shadow: 0 0 0 2px var(--border-focus);
  }

  /* ── Win overlay ──────────────────────────────────────────────────── */
  .pz-win {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
    border-radius: var(--radius-md);
    background: rgba(9, 10, 15, 0.88);
    backdrop-filter: blur(4px);
    text-align: center;
    z-index: 3;
  }

  .pz-win[hidden] {
    display: none;
  }

  .pz-win-title {
    font-family: var(--font-display);
    font-size: 1.6rem;
    color: #fbbf24;
  }

  .pz-win-sub {
    margin-bottom: 14px;
    color: var(--text-secondary);
    font-size: 0.86rem;
  }

  /* ── Controls ─────────────────────────────────────────────────────── */
  .pz-controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    margin-top: 16px;
  }

  .pz-btn {
    min-height: 42px;
    padding: 0 18px;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-full);
    background: rgba(255, 255, 255, 0.04);
    color: var(--text-primary);
    font-family: var(--font-sans);
    font-size: 0.85rem;
    font-weight: 700;
    cursor: pointer;
    transition: background 0.15s ease, border-color 0.15s ease;
  }

  .pz-btn--primary {
    border-color: transparent;
    background: linear-gradient(180deg, #fbbf24, #f59e0b);
    color: #1a1206;
  }

  .pz-btn:hover {
    filter: brightness(1.06);
  }

  .pz-sizes {
    display: inline-flex;
    gap: 6px;
  }

  .pz-size {
    min-height: 42px;
    padding: 0 14px;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-full);
    background: transparent;
    color: var(--text-tertiary);
    font-family: var(--font-mono);
    font-size: 0.76rem;
    font-weight: 700;
    cursor: pointer;
  }

  .pz-size.is-active {
    border-color: rgba(245, 158, 11, 0.5);
    background: rgba(245, 158, 11, 0.1);
    color: #fbbf24;
  }

  .pz-hint {
    margin-top: 12px;
    color: var(--text-tertiary);
    font-size: 0.76rem;
    text-align: center;
  }

  /* ── Content sections ─────────────────────────────────────────────── */
  .pz-section {
    margin-top: 48px;
  }

  .pz-section h2 {
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 3vw, 1.5rem);
    letter-spacing: -0.02em;
    margin-bottom: 14px;
  }

  .pz-steps {
    display: grid;
    gap: 10px;
    margin: 0 0 14px;
    padding-left: 20px;
    color: var(--text-secondary);
    font-size: 0.88rem;
    line-height: 1.65;
  }

  .pz-steps strong {
    color: var(--text-primary);
  }

  .pz-note {
    padding: 12px 14px;
    border: 1px solid rgba(245, 158, 11, 0.25);
    border-radius: var(--radius-sm);
    background: rgba(245, 158, 11, 0.06);
    color: var(--text-secondary);
    font-size: 0.84rem;
    line-height: 1.6;
  }

  .pz-cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
    gap: 10px;
  }

  .pz-card {
    padding: 16px;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    background: var(--bg-surface);
  }

  .pz-card h3 {
    margin-bottom: 6px;
    font-size: 0.9rem;
  }

  .pz-card p {
    color: var(--text-secondary);
    font-size: 0.82rem;
    line-height: 1.6;
  }

  .pz-faq {
    display: grid;
    gap: 8px;
  }

  .pz-faq details {
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    background: var(--bg-surface);
    padding: 0 14px;
  }

  .pz-faq summary {
    padding: 13px 0;
    font-size: 0.88rem;
    font-weight: 600;
    cursor: pointer;
    list-style: none;
  }

  .pz-faq summary::-webkit-details-marker {
    display: none;
  }

  .pz-faq p {
    padding-bottom: 13px;
    color: var(--text-secondary);
    font-size: 0.84rem;
    line-height: 1.65;
  }

  @media (max-width: 420px) {
    .pz {
      padding: 20px 14px 56px;
    }

    .pz-board-wrap {
      padding: 12px;
    }

    .pz-controls {
      justify-content: center;
    }
  }
</style>

<!-- Tiles are created at runtime, so their styles must be global. -->
<style is:global>
  .pz-tile {
    position: absolute;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 10px;
    background: linear-gradient(180deg, #232736, #1a1d28);
    color: #f8fafc;
    font-family: var(--font-mono);
    font-size: clamp(1rem, 5.2vw, 1.7rem);
    font-weight: 700;
    line-height: 1;
    cursor: pointer;
    transition: left 0.14s ease, top 0.14s ease, background 0.14s ease;
    user-select: none;
    -webkit-tap-highlight-color: transparent;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.05);
  }

  .pz-tile:hover {
    background: linear-gradient(180deg, #2b3044, #212532);
  }

  .pz-tile.is-movable {
    border-color: rgba(245, 158, 11, 0.4);
    color: #fbbf24;
  }

  .pz-tile.is-correct {
    border-color: rgba(16, 185, 129, 0.3);
    color: #6ee7b7;
  }
</style>

<script>
  (function () {
    const boardEl = document.getElementById('pzBoard');
    const movesEl = document.getElementById('pzMoves');
    const timeEl = document.getElementById('pzTime');
    const bestEl = document.getElementById('pzBest');
    const winEl = document.getElementById('pzWin');
    const winSub = document.getElementById('pzWinSub');
    const newBtn = document.getElementById('pzNew');
    const winAgain = document.getElementById('pzWinAgain');
    const sizeBtns = Array.from(document.querySelectorAll('.pz-size'));

    if (!boardEl || !movesEl || !timeEl || !bestEl || !winEl) return;

    let size = 4;
    let tiles = [];
    let blank = 0;
    let moves = 0;
    let startedAt = 0;
    let timer = null;
    let solved = false;

    const tileEls = [];

    const bestKey = (n) => `eggm:puzzle:best:${n}x${n}`;

    function bestLabel(n) {
      try {
        const raw = localStorage.getItem(bestKey(n));
        if (!raw) return '—';
        const v = JSON.parse(raw);
        return `${v.moves} / ${fmt(v.seconds)}`;
      } catch {
        return '—';
      }
    }

    function fmt(seconds) {
      const m = Math.floor(seconds / 60);
      const s = seconds % 60;
      return `${m}:${String(s).padStart(2, '0')}`;
    }

    function isSolved() {
      for (let i = 0; i < tiles.length - 1; i++) if (tiles[i] !== i + 1) return false;
      return tiles[tiles.length - 1] === 0;
    }

    function movable(index) {
      const r = Math.floor(index / size);
      const c = index % size;
      const br = Math.floor(blank / size);
      const bc = blank % size;
      return Math.abs(r - br) + Math.abs(c - bc) === 1;
    }

    function render() {
      const pct = 100 / size;
      tiles.forEach((val, i) => {
        const el = tileEls[i];
        if (!el) return;
        const r = Math.floor(i / size);
        const c = i % size;
        el.style.width = `calc(${pct}% - 6px)`;
        el.style.height = `calc(${pct}% - 6px)`;
        el.style.left = `calc(${c * pct}% + 3px)`;
        el.style.top = `calc(${r * pct}% + 3px)`;
        el.textContent = val === 0 ? '' : String(val);
        el.classList.toggle('is-correct', val !== 0 && val === i + 1);
        el.classList.toggle('is-movable', val !== 0 && movable(i));
        el.setAttribute('aria-label', val === 0 ? 'empty' : `tile ${val}`);
        el.style.cursor = val !== 0 && movable(i) ? 'pointer' : 'default';
        el.style.opacity = val === 0 ? '0' : '1';
        el.style.pointerEvents = val === 0 ? 'none' : 'auto';
      });
    }

    function stopTimer() {
      if (timer) {
        clearInterval(timer);
        timer = null;
      }
    }

    function tick() {
      const secs = Math.floor((Date.now() - startedAt) / 1000);
      timeEl!.textContent = fmt(secs);
    }

    function finish() {
      solved = true;
      stopTimer();
      const secs = startedAt ? Math.floor((Date.now() - startedAt) / 1000) : 0;
      if (winSub) winSub.textContent = `${moves} moves in ${fmt(secs)}`;
      winEl!.hidden = false;
      let improved = false;
      try {
        const raw = localStorage.getItem(bestKey(size));
        const prev = raw ? JSON.parse(raw) : null;
        if (!prev || moves < prev.moves) {
          localStorage.setItem(bestKey(size), JSON.stringify({ moves, seconds: secs }));
          improved = true;
        }
      } catch {
        /* storage unavailable */
      }
      bestEl!.textContent = bestLabel(size);
      if (improved && winSub) winSub.textContent += ' · new best';
    }

    function move(index: number, countIt = true) {
      if (solved || !movable(index)) return;
      if (!startedAt) {
        startedAt = Date.now();
        timer = setInterval(tick, 500);
      }
      const t = tiles[index];
      tiles[index] = tiles[blank];
      tiles[blank] = t;
      blank = index;
      if (countIt) {
        moves++;
        movesEl!.textContent = String(moves);
      }
      render();
      if (isSolved()) finish();
    }

    function shuffle(n) {
      size = n;
      const total = n * n;
      tiles = Array.from({ length: total }, (_, i) => (i === total - 1 ? 0 : i + 1));
      blank = total - 1;

      // legal random walk backwards from the solved state
      let prev = -1;
      for (let k = 0; k < 400; k++) {
        const br = Math.floor(blank / n);
        const bc = blank % n;
        const opts = [];
        if (br > 0) opts.push(blank - n);
        if (br < n - 1) opts.push(blank + n);
        if (bc > 0) opts.push(blank - 1);
        if (bc < n - 1) opts.push(blank + 1);
        const choices = opts.filter((i) => i !== prev);
        const pick = choices[Math.floor(Math.random() * choices.length)];
        prev = blank;
        const t = tiles[pick];
        tiles[pick] = tiles[blank];
        tiles[blank] = t;
        blank = pick;
      }
      if (isSolved()) return shuffle(n);
    }

    function buildBoard() {
      boardEl!.innerHTML = '';
      tileEls.length = 0;
      const total = size * size;
      for (let i = 0; i < total; i++) {
        const el = document.createElement('button');
        el.type = 'button';
        el.className = 'pz-tile';
        el.tabIndex = -1;
        el.addEventListener('click', () => move(tileEls.indexOf(el)));
        boardEl!.appendChild(el);
        tileEls.push(el);
      }
    }

    function newGame(n = size) {
      stopTimer();
      solved = false;
      startedAt = 0;
      moves = 0;
      movesEl!.textContent = '0';
      timeEl!.textContent = '0:00';
      bestEl!.textContent = bestLabel(n);
      winEl!.hidden = true;
      sizeBtns.forEach((b) => b.classList.toggle('is-active', Number(b.dataset.size) === n));
      shuffle(n);
      buildBoard();
      render();
    }

    boardEl.addEventListener('keydown', (e) => {
      const br = Math.floor(blank / size);
      const bc = blank % size;
      let target = -1;
      if (e.key === 'ArrowUp' && br < size - 1) target = blank + size;
      else if (e.key === 'ArrowDown' && br > 0) target = blank - size;
      else if (e.key === 'ArrowLeft' && bc < size - 1) target = blank + 1;
      else if (e.key === 'ArrowRight' && bc > 0) target = blank - 1;
      if (target >= 0) {
        e.preventDefault();
        move(target);
      }
    });

    newBtn?.addEventListener('click', () => newGame());
    winAgain?.addEventListener('click', () => newGame());
    sizeBtns.forEach((b) =>
      b.addEventListener('click', () => newGame(Number(b.dataset.size) || 4)),
    );

    newGame(4);
  })();
</script>
